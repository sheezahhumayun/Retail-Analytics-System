# Copy to .env and adjust for your machine:
#   copy .env.example .env

# PostgreSQL (Docker Compose maps host 5433 → container 5432)
DATABASE_URL=postgresql+psycopg2://retail:retail@localhost:5433/retail_analytics

# Raw analytics events retention in days (aggregated metrics are kept)
RAW_EVENT_RETENTION_DAYS=90

# Store local timezone for hourly visitor/zone rollups and event bucketing (IANA name).
# Must match the deployment's actual local timezone (requires: pip install tzdata on Windows).
STORE_TIMEZONE=Asia/Karachi

# Optional — enable live RTSP integration tests
# RTSP_TEST_URL=rtsp://user:pass@10.0.0.5:554/stream

# Module 12 — Backend API (JWT auth)
JWT_SECRET_KEY=change-me-in-production
API_DEFAULT_PASSWORD=demo
